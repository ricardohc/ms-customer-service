              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-ID", "value": "{{correlationId}}" },
              { "key": "X-Channel-ID", "value": "{{channelId}}" },
              { "key": "X-Transaction-ID", "value": "{{transactionId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerType\": \"PERSONAL\",\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"12345678\",\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Perez\",\n  \"email\": \"juan.perez@example.com\",\n  \"phoneNumber\": \"987654321\",\n  \"profile\": \"STANDARD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers"]
            }
          }
